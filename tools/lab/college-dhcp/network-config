version: 2
ethernets:
  class:
    match: {macaddress: "00:15:5d:10:00:61"}
    # שתי כתובות על כרטיס אחד, ובכוונה:
    #   10.97.0.2  — הכתובת בוילן הכיתה, שם המכונה יושבת מאז #50.
    #   10.98.10.2 — הכתובת ההיסטורית ברשת הרגילה. היא מה שמאפשר
    #                לבנות את המכונה מחדש בשלב הכנה על ImageCtl-LAN
    #                (‏apt דורש אינטרנט, ומוילן הכיתה אין — L8 חוסם).
    #                אחרי המעבר לסוויץ' ImageCtl-Class היא פשוט אינה
    #                מנותבת לשום מקום, ואינה מזיקה.
    addresses: [10.97.0.2/24, 10.98.10.2/24]
    routes:
      # ‏metric 100 — נתיב ברירת המחדל של שלב ההכנה, דרך המארח.
      # בוילן הכיתה הוא בלתי-נגיש ופשוט לא בשימוש; ל-dnsmasq אין
      # תעבורה יוצאת ולכן זה לא מפריע.
      - {to: default, via: 10.98.10.1, metric: 100}
    nameservers: {addresses: [1.1.1.1]}
