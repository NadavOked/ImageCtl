version: 2
ethernets:
  # מכוון לפי שם הכרטיס ולא לפי MAC, **בכוונה**: עדיין לא הוכרע איזו
  # מכונה תשמש לקוח כיתה (ראו הערת הטופולוגיה ב-user-data). התאמה
  # לפי MAC הייתה מקבעת מכונה אחת, ומכונה שלא תואמת נשארת בלי רשת —
  # כשל שנראה מקונסולה סריאלית כמו חומת אש שחוסמת.
  client:
    match: {name: "en*"}
    # ‏DHCP הוא המסלול הראשי, והוא **חלק מהבדיקה**: מי שאמור לענות
    # בוילן הכיתה הוא dnsmasq של חומת האש (10.97.0.100–140).
    dhcp4: true
    # רשת ביטחון: כתובת סטטית מחוץ לטווח ה-DHCP. אם dnsmasq שותק,
    # הבדיקה עדיין רצה ומדווחת — במקום מכונה בלי רשת שאי אפשר
    # לאבחן דרך קונסולה סריאלית בלבד.
    addresses: [10.97.0.60/24]
    routes:
      # ‏metric 2000 גבוה מ-1024 שבו systemd-networkd מתקין את נתיב
      # ברירת המחדל של DHCP — כך נתיב ה-DHCP מנצח כשהוא קיים, וזה
      # מה שמאפשר לעלות פעם אחת על ImageCtl-LAN ולמשוך חבילות.
      - {to: default, via: 10.97.0.1, metric: 2000}
