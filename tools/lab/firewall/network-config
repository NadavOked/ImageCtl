version: 2
ethernets:
  # רגל הכיתה — וילן הכיתות המדומה. חומת האש היא ה-gateway שלו.
  class:
    match: {macaddress: "00:15:5d:10:00:71"}
    addresses: [10.97.0.1/24]
  # רגל ה-LAN — הרשת הרגילה, שם יושב השרת (10.98.10.8).
  lan:
    match: {macaddress: "00:15:5d:10:00:72"}
    addresses: [10.98.10.9/24]
    routes: [{to: default, via: 10.98.10.1}]
    nameservers: {addresses: [1.1.1.1]}
