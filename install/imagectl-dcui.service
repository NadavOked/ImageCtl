# ImageCtl physical operations console (#910 part 2).
# The installer must mask getty@tty1.service before enabling this unit.
[Unit]
Description=ImageCtl DCUI (physical console on tty1)
After=imagectl-server.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
WorkingDirectory=/opt/imagectl
ExecStart=/usr/bin/python3 -m server.dcui --data-dir /var/lib/imagectl
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
User=root

# Root is required for systemctl, ifup/ifdown and the directly managed files.
# ProtectSystem remains strict; only the existing ImageCtl write locations are
# opened. AF_UNIX is required by systemd, AF_NETLINK by iproute2, and
# AF_INET/AF_INET6/AF_PACKET by ifup/dhclient while applying DHCP.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6 AF_PACKET
ReadWritePaths=/var/lib/imagectl /etc/network/interfaces.d /etc /var/lib/dhcp

[Install]
WantedBy=multi-user.target
