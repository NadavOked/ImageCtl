# ImageCtl — explicit post-install rerun of the first-boot wizard (#1163).
[Unit]
Description=ImageCtl first-boot web wizard (explicit rerun)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/imagectl-src
ExecStart=/usr/bin/python3 -m server.wizard --rerun --host 0.0.0.0 --port 8081 \
    --data-dir /var/lib/imagectl \
    --status-file /etc/imagectl/firstboot.status \
    --installer-nic /etc/imagectl/installer-nic \
    --installer-role /etc/imagectl/installer-role
Restart=no
StandardOutput=journal+console
StandardError=journal+console
