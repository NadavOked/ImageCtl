# ImageCtl first-boot installer on the server's own screen (#1188).
[Unit]
Description=ImageCtl native first-boot installer (tty1)
After=imagectl-wizard.service network-online.target
Wants=imagectl-wizard.service network-online.target
Conflicts=getty@tty1.service imagectl-dcui.service

[Service]
Type=simple
WorkingDirectory=/opt/imagectl-src
ExecStart=/opt/imagectl-src/native-gui/imagectl-station-gui --screen install --wizard-cwd /opt/imagectl-src
ExecStopPost=systemctl start imagectl-dcui.service
Restart=no
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
User=root

[Install]
WantedBy=multi-user.target
