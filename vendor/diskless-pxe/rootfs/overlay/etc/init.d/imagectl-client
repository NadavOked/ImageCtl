#!/sbin/openrc-run
name="ImageCtl diskless client"
description="Starts ImageCtl kiosk only after networking is ready"
depend() { need net; after firewall; }
start() {
  ebegin "ImageCtl preflight"
  /usr/local/sbin/imagectl-preflight || { eend 1; return 1; }
  eend 0
  ebegin "Starting ImageCtl kiosk supervisor"
  start-stop-daemon --start --background --make-pidfile --pidfile /run/imagectl-kiosk.pid --exec /usr/local/bin/imagectl-kiosk-supervisor
  eend $?
}
stop() { start-stop-daemon --stop --pidfile /run/imagectl-kiosk.pid; }
