#!ipxe
# ImageCtl diskless bootstrap. Replace URLs at integration time.
dhcp || goto net_fail
set server http://192.168.1.10:8080
set base ${server}/diskless
kernel ${base}/vmlinuz-lts ip=dhcp imagectl.server=${server} quiet || goto boot_fail
initrd ${base}/initramfs || goto boot_fail
boot || goto boot_fail

:net_fail
echo DHCP/network initialization failed
sleep 5
reboot

:boot_fail
echo ImageCtl diskless boot failed
sleep 10
shell
