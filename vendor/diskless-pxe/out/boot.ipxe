#!ipxe
# Generated from config; safe to host outside ImageCtl until integration.
set server http://192.168.1.10:8080
set base ${server}/diskless
set attempt 0

:retry
inc attempt
isset ${net0/ip} || dhcp || goto retry_or_fail
imgfree
kernel ${base}/vmlinuz-lts ip=dhcp imagectl.server=${server} initrd=initramfs-lts quiet || goto retry_or_fail
initrd ${base}/initramfs-lts || goto retry_or_fail
boot || goto retry_or_fail

:retry_or_fail
iseq ${attempt} 3 && goto failed ||
echo Diskless boot attempt ${attempt}/3 failed; retrying...
sleep 2
goto retry

:failed
echo ImageCtl diskless bootstrap failed.
echo Press S for iPXE shell or wait to reboot.
prompt --key 0x73 --timeout 5000 Open shell? && shell || reboot
