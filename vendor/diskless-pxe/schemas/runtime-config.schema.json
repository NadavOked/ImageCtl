{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"ImageCtl Diskless Client Runtime Configuration",
  "type":"object","additionalProperties":false,
  "properties":{
    "server_base_url":{"type":"string","pattern":"^https?://"},
    "kiosk_url":{"type":"string","pattern":"^https?://"},
    "allow_imaging":{"type":"boolean","default":false},
    "target_device":{"type":["string","null"]},
    "network_timeout":{"type":"integer","minimum":1,"maximum":300}
  },
  "required":["server_base_url","kiosk_url","allow_imaging"]
}
