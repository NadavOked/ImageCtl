#!/bin/sh
# init -- PID 1 of the ImageCtl initramfs. Mounts the pseudo-filesystems,
# loads drivers, brings the network up with DHCP, then hands over to the
# agent. If anything here fails, the machine reboots -- which lands back
# in GRUB, whose default is the local disk.

export PATH=/usr/sbin:/usr/bin:/sbin:/bin

fail() {
    echo "imagectl init: $1 -- rebooting in 5s"
    sleep 5
    sync
    reboot -f
}

mount -t proc     proc     /proc  2>/dev/null
mount -t sysfs    sysfs    /sys   2>/dev/null
mount -t devtmpfs devtmpfs /dev   2>/dev/null
mkdir -p /dev/pts /run
mount -t devpts   devpts   /dev/pts 2>/dev/null
mount -t tmpfs    tmpfs    /run   2>/dev/null
mkdir -p /run/imagectl
RUN_DIR="${RUN_DIR:-/run/imagectl}"

# Storage and NIC drivers. The list is generated at build time. A module that
# does not load has two opposite meanings, and folding them into one line taught
# the operator to ignore the message (#407, principle 5): a *platform* driver
# not loading is the expected case -- 8 virtualization drivers on bare metal,
# plus whatever NIC/disk hardware this machine simply does not have -- while a
# *required* module (the filesystem set in /etc/imagectl/modules.required) not
# loading is a broken initramfs that will let restore corrupt data silently
# (#84, #107, #121). Both are reported BY NAME, never as a bare count: `9
# modules did not load` is the same digit whether all nine were superfluous or
# one was the network driver a headless machine needed to stay reachable.
#
# ‏`2>/dev/null` לבדו הפך כל כישלון טעינה לבלתי-נראה, ומודול שלא נטען
# נראה בדיוק כמו מודול שנטען. ‏`sungem: Unknown symbol` נמצא ככה רק
# כשהודפס dmesg ידנית במעבדה. סופרים, מסווגים ומדווחים בשם (#76, #407).
MOD_DIR="${MOD_DIR:-/etc/imagectl}"
_required=" $(tr '\n' ' ' < "$MOD_DIR/modules.required" 2>/dev/null) "
_req_fail=""
_opt_fail=""
if [ -f "$MOD_DIR/modules" ]; then
    while read -r _m; do
        [ -n "$_m" ] || continue
        modprobe "$_m" 2>/dev/null && continue
        case "$_required" in
            *" $_m "*) _req_fail="$_req_fail$_m " ;;
            *)         _opt_fail="$_opt_fail$_m " ;;
        esac
    done < "$MOD_DIR/modules"
fi
[ -n "$_opt_fail" ] && \
    echo "imagectl init: platform modules absent, expected on this hardware: $_opt_fail"
if [ -n "$_req_fail" ]; then
    printf '%s\n' "$_req_fail" | tr ' ' '\n' | awk 'NF' > "$RUN_DIR/modules.failed.next" \
        || fail "could not write the required-module failure list"
    mv "$RUN_DIR/modules.failed.next" "$RUN_DIR/modules.failed" \
        || fail "could not publish the required-module failure list"
    echo "imagectl init: ERROR required modules did not load, restore may corrupt: $_req_fail"
else
    rm -f "$RUN_DIR/modules.failed"
fi

# efivars for the SecureBoot bit in hello -- after the module load, because
# efivarfs is itself one of them (CONFIG_EFIVAR_FS=m).
#
# מכונת BIOS פשוט אין לה /sys/firmware/efi, וזה לא כישלון. אבל מכונת
# UEFI שה-efivars שלה לא נעגן היא מכונה שאיננו יודעים מה מצב ה-Secure
# Boot שלה — וזה בדיוק מה ש-hello יגיד עליה. קודם לכן זה נבלע, המודול
# לא היה שם בכלל, וכל מכונה דיווחה "כבוי" (#84).
if [ -d /sys/firmware/efi ]; then
    mkdir -p /sys/firmware/efi/efivars
    mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null \
        || echo "imagectl init: efivarfs would not mount -- SecureBoot state unknown"
fi

# Give USB/PCI enumeration a moment before looking for NICs and disks.
sleep 2

# --- the install ISO (#1190) --------------------------------------------------
# imagectl.mode=installer on the kernel line: this image was booted from the
# ImageCtl install ISO, not by PXE. The live installer needs no lease (the
# install is offline) and must never reboot-loop on a network that is not
# there yet, so it takes over before the DHCP loop below. Only parse_cmdline
# reads the kernel line (principle 2); the mode is one of its two words.
LIB_DIR="${LIB_DIR:-/usr/lib/imagectl}"
if [ -f "$LIB_DIR/common.sh" ]; then
    . "$LIB_DIR/common.sh"
    parse_cmdline
    if [ "$IMAGECTL_MODE" = installer ]; then
        [ -f "$LIB_DIR/installer_boot.sh" ] || fail "installer image without installer_boot.sh"
        . "$LIB_DIR/installer_boot.sh"
        installer_boot
        fail "installer handover returned"
    fi
fi

# --- network -----------------------------------------------------------------
# Try every wired interface with a carrier, in order, until DHCP answers.
# PXE got an address seconds ago on one of them, so this converges fast.

ip link set lo up 2>/dev/null

IFACE=""
_deadline=$(( $(date +%s) + 90 ))
while [ -z "$IFACE" ]; do
    for _d in /sys/class/net/*; do
        _n=$(basename "$_d")
        [ "$_n" = "lo" ] && continue
        ip link set "$_n" up 2>/dev/null
        sleep 1
        _carrier=$(cat "$_d/carrier" 2>/dev/null || echo 0)
        [ "$_carrier" = "1" ] || continue
        if udhcpc -i "$_n" -n -q -t 4 -T 3 -s /etc/imagectl/udhcpc.script \
            >/dev/null 2>&1; then
            IFACE="$_n"
            break
        fi
    done
    [ "$(date +%s)" -lt "$_deadline" ] || fail "no DHCP lease on any interface"
done

IP=$(ip -4 addr show "$IFACE" 2>/dev/null \
     | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -n 1)
[ -n "$IP" ] || fail "DHCP succeeded but no address on $IFACE"

printf 'IFACE=%s\nIP=%s\n' "$IFACE" "$IP" > /run/imagectl/net.conf
echo "imagectl init: network up on $IFACE ($IP)"

# --- boot trace (#400) --------------------------------------------------------
# The first thing this machine can say for itself. It proves three things at
# once: the initramfs unpacked, this script ran to here, and DHCP answered.
#
# There is deliberately no earlier breadcrumb for "init started": before DHCP
# there is no network and nothing to report over. If this one is missing while
# GRUB's pre-boot arrived, THAT gap is the finding -- which is the whole point
# of keeping the step list closed on the server (boot/trace.py).
#
# common.sh is sourced rather than parsed again here: the kernel command line
# has exactly one reader in this codebase (parse_cmdline), and a second one
# would be a second, undocumented interface -- principle 2, guarded by
# test_only_common_touches_proc_cmdline.
#
# Never fatal, and never silent: trace_step always returns 0 and logs a
# failed delivery. A diagnostic that stops a machine booting is damage.
if [ -f "$LIB_DIR/common.sh" ]; then
    SERVER="$IMAGECTL_SERVER"
    MAC=$(cat "/sys/class/net/$IFACE/address" 2>/dev/null)
    trace_step agent-net
fi

# --- hand over ---------------------------------------------------------------

/usr/bin/imagectl-agent
fail "agent exited"
